{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "architecture-model.ai-work-order/1.0.0",
  "title": "AIWorkOrder",
  "description": "Bounded work order submitted to an AI agent for architecture-model reasoning.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "contract_version",
    "intent",
    "input_slice_refs",
    "expected_proposal_kinds",
    "parameters",
    "budget",
    "requested_by",
    "created_at"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "contract_version": {"type": "string", "const": "1.0.0"},
    "intent": {"type": "string", "minLength": 1},
    "input_slice_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slice_id", "model_revision"],
        "properties": {
          "slice_id": {"type": "string", "minLength": 1},
          "model_revision": {"type": "string", "minLength": 1}
        }
      }
    },
    "expected_proposal_kinds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "model-patch",
          "decomposition-proposal",
          "slice-proposal",
          "view-curation-proposal",
          "artifact-candidate",
          "impact-assessment"
        ]
      }
    },
    "parameters": {"type": "object"},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_tokens", "max_wall_seconds"],
      "properties": {
        "max_tokens": {"type": "integer", "minimum": 1},
        "max_wall_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "requested_by": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1}
  }
}
