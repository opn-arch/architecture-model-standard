{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architecture-model.dev/spec/artifact-spec.schema.json",
  "title": "ArtifactSpec",
  "description": "Renderable-artifact contract bound to a view or an aggregation of siblings (see architecture_model.lifecycle.artifact_spec).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "contract_version", "renderer"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "contract_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "renderer": {
      "type": "string",
      "enum": ["svg", "markdown", "html", "ai-context", "zip"]
    },
    "view_ref": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["view_id", "model_revision"],
      "properties": {
        "view_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "model_revision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "bundle_refs": {
      "type": ["array", "null"],
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9._-]+$"
      }
    },
    "parameters": {
      "type": "object",
      "default": {}
    },
    "signature_slots": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["algorithm", "key_id"],
        "properties": {
          "algorithm": {"type": "string", "minLength": 1},
          "key_id": {"type": "string", "minLength": 1},
          "signature": {"type": ["string", "null"]}
        }
      }
    },
    "generated_at": {
      "type": ["string", "null"]
    }
  },
  "oneOf": [
    {
      "properties": {
        "renderer": {"const": "zip"},
        "bundle_refs": {"type": "array", "minItems": 1}
      },
      "required": ["bundle_refs"],
      "not": {"required": ["view_ref"]}
    },
    {
      "properties": {
        "renderer": {"not": {"const": "zip"}}
      },
      "required": ["view_ref"]
    }
  ]
}
