{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architecture-model-standard.dev/schema/v2.1.0/model.json",
  "title": "Architecture Model",
  "description": "Universal machine-readable architecture model for LLM-driven system engineering",
  "type": "object",
  "required": [
    "meta",
    "entities",
    "relationships"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "schema_version",
        "project",
        "generated_at"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "project": {
          "type": "string"
        },
        "system": {
          "type": "string"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_artifacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "manifest_hash": {
          "type": "string"
        },
        "source_language": {
          "type": "string"
        },
        "parent_model": {
          "type": "string"
        },
        "refines_component": {
          "type": "string"
        },
        "provider": {
          "type": "object",
          "properties": {
            "name":       {"type": "string"},
            "model":      {"type": "string"},
            "policy_ref": {"type": "string"}
          },
          "required": ["name", "model"],
          "additionalProperties": false
        }
      }
    },
    "entities": {
      "type": "object",
      "properties": {
        "actors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/actor"
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capability"
          }
        },
        "behaviors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/behavior"
          }
        },
        "interfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interface"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/constraint"
          }
        },
        "layers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/layer"
          }
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "systems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/system"
          }
        },
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/data"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource"
          }
        },
        "environments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/environment"
          }
        },
        "quality_attributes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quality_attribute"
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision"
          }
        },
        "lifecycles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lifecycle"
          }
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement"
          }
        },
        "external_systems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/external_system"
          }
        }
      },
      "unevaluatedProperties": false
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    }
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "PLANNED",
        "DORMANT",
        "DEPRECATED"
      ]
    },
    "extensions": {
      "type": "object",
      "patternProperties": {
        "^x-": {}
      },
      "unevaluatedProperties": false
    },
    "decision_entry": {
      "type": "object",
      "required": [
        "choice"
      ],
      "properties": {
        "date": {
          "type": "string"
        },
        "choice": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "context": {
          "type": "string"
        }
      },
      "unevaluatedProperties": false
    },
    "base_entity": {
      "type": "object",
      "required": [
        "id",
        "name",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]+-[A-Z]?-?\\d+$|^[a-z][a-z0-9-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_file": {
          "type": "string"
        },
        "source_line": {
          "type": "integer",
          "minimum": 0
        },
        "intent": {
          "type": "string"
        },
        "goals": {
          "$ref": "#/$defs/semantic_string_list"
        },
        "requirements": {
          "$ref": "#/$defs/requirement_ref_list",
          "description": "Requirement entity IDs or inline requirement statements"
        },
        "rationale": {
          "type": "string"
        },
        "moes": {
          "$ref": "#/$defs/semantic_string_list"
        },
        "value_function": {
          "type": "string"
        },
        "failure_modes": {
          "$ref": "#/$defs/failure_mode_list"
        },
        "trade_offs": {
          "$ref": "#/$defs/trade_off_list"
        },
        "interface_refs": {
          "$ref": "#/$defs/semantic_string_list",
          "description": "Interface entity IDs or contract names"
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision_entry"
          }
        },
        "monitored": {
          "$ref": "#/$defs/semantic_string_list"
        }
      }
    },
    "semantic_string_list": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "maturity": {
      "type": "string",
      "enum": [
        "proposal",
        "draft",
        "active",
        "stable",
        "deprecated"
      ]
    },
    "failure_mode_obj": {
      "type": "object",
      "required": ["id", "cause", "effect", "likelihood", "severity", "detection", "mitigation"],
      "properties": {
        "id": {"type": "string"},
        "cause": {"type": "string"},
        "effect": {"type": "string"},
        "likelihood": {
          "type": "string",
          "enum": ["rare", "unlikely", "possible", "likely", "certain"]
        },
        "severity": {
          "type": "string",
          "enum": ["negligible", "minor", "moderate", "major", "catastrophic"]
        },
        "detection": {"type": "string"},
        "mitigation": {"type": "string"},
        "mitigated_by": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "trade_off_obj": {
      "type": "object",
      "required": ["id", "decision", "alternatives", "rationale", "consequences", "revisit_when"],
      "properties": {
        "id": {"type": "string"},
        "decision": {"type": "string"},
        "alternatives": {
          "type": "array",
          "items": {"type": "string"}
        },
        "rationale": {"type": "string"},
        "consequences": {
          "type": "array",
          "items": {"type": "string"}
        },
        "revisit_when": {"type": "string"},
        "status": {
          "type": "string",
          "enum": ["active", "superseded", "revisited"]
        }
      },
      "additionalProperties": false
    },
    "slo_obj": {
      "type": "object",
      "required": ["metric", "target", "window"],
      "properties": {
        "metric": {"type": "string"},
        "target": {"type": "string"},
        "window": {"type": "string"},
        "current": {"type": "string"}
      },
      "additionalProperties": false
    },
    "requirement_ref_obj": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {"type": "string"},
        "note": {"type": "string"}
      },
      "additionalProperties": false
    },
    "verification_ref_obj": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {"type": "string"},
        "method": {"type": "string"},
        "target": {"type": "string"}
      },
      "additionalProperties": false
    },
    "failure_mode_list": {
      "type": "array",
      "items": {
        "oneOf": [
          {"type": "string"},
          {"$ref": "#/$defs/failure_mode_obj"}
        ]
      }
    },
    "trade_off_list": {
      "type": "array",
      "items": {
        "oneOf": [
          {"type": "string"},
          {"$ref": "#/$defs/trade_off_obj"}
        ]
      }
    },
    "slo_list": {
      "type": "array",
      "items": {"$ref": "#/$defs/slo_obj"}
    },
    "requirement_ref_list": {
      "type": "array",
      "items": {
        "oneOf": [
          {"type": "string"},
          {"$ref": "#/$defs/requirement_ref_obj"}
        ]
      }
    },
    "verification_ref_list": {
      "type": "array",
      "items": {"$ref": "#/$defs/verification_ref_obj"}
    },
    "actor": {
      "allOf": [
        {
          "$ref": "#/$defs/base_entity"
        }
      ],
      "properties": {
        "id": true,
        "name": true,
        "description": true,
        "status": true,
        "tags": true,
        "source_file": true,
        "source_line": true,
        "type": {
          "type": "string",
          "enum": [
            "human",
            "system",
            "external-service"
          ]
        },
        "goals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        },
        "intent": true,
        "decisions": true,
        "assumptions": {"$ref": "#/$defs/semantic_string_list"},
        "open_questions": {"$ref": "#/$defs/semantic_string_list"}
      },
      "unevaluatedProperties": false
    },
    "capability": {
      "allOf": [
        {
          "$ref": "#/$defs/base_entity"
        }
      ],
      "properties": {
        "id": true,
        "name": true,
        "description": true,
        "status": true,
        "tags": true,
        "source_file": true,
        "source_line": true,
        "source_block": {
          "type": "string"
        },
        "priority": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ]
        },
        "requirements": {
          "$ref": "#/$defs/requirement_ref_list"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        },
        "moes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "goals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "trade_offs": {
          "$ref": "#/$defs/trade_off_list"
        },
        "failure_modes": {
          "$ref": "#/$defs/failure_mode_list"
        },
        "monitored": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "intent": true,
        "decisions": true,
        "stakeholders": {"$ref": "#/$defs/semantic_string_list"},
        "success_criteria": {"$ref": "#/$defs/semantic_string_list"},
        "assumptions": {"$ref": "#/$defs/semantic_string_list"},
        "open_questions": {"$ref": "#/$defs/semantic_string_list"},
        "verification": {"$ref": "#/$defs/verification_ref_list"},
        "owner": {"type": "string"},
        "maturity": {"$ref": "#/$defs/maturity"}
      },
      "unevaluatedProperties": false
    },
    "behavior": {
      "allOf": [
        {
          "$ref": "#/$defs/base_entity"
        }
      ],
      "properties": {
        "id": true,
        "name": true,
        "description": true,
        "status": true,
        "tags": true,
        "source_file": true,
        "source_line": true,
        "trigger": {
          "type": "string"
        },
        "actor": {
          "type": "string"
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "postconditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "structured_steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["order", "action"],
            "properties": {
              "order": {"type": "integer", "minimum": 1},
              "action": {"type": "string"},
              "component_ref": {"type": "string"},
              "actor": {"type": "string"},
              "input": {"type": "string"},
              "output": {"type": "string"},
              "error_handling": {"type": "string"}
            },
            "unevaluatedProperties": false
          }
        },
        "behavior_type": {"type": "string"},
        "actor_id": {"type": "string"},
        "capability_id": {"type": "string"},
        "frequency": {
          "type": "string"
        },
        "priority": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ]
        },
        "pattern": {
          "type": "string",
          "enum": [
            "sequential",
            "event-driven",
            "state-machine",
            "saga",
            "pipeline",
            "parallel"
          ]
        },
        "states": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "transitions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "to": {
                      "type": "string"
                    },
                    "trigger": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "compensations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "step",
              "compensate"
            ],
            "properties": {
              "step": {
                "type": "string"
              },
              "compensate": {
                "type": "string"
              }
            }
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        },
        "goals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "moes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "failure_modes": {
          "$ref": "#/$defs/failure_mode_list"
        },
        "intent": true,
        "decisions": true,
        "stakeholders": {"$ref": "#/$defs/semantic_string_list"},
        "success_criteria": {"$ref": "#/$defs/semantic_string_list"},
        "assumptions": {"$ref": "#/$defs/semantic_string_list"},
        "open_questions": {"$ref": "#/$defs/semantic_string_list"},
        "verification": {"$ref": "#/$defs/verification_ref_list"},
        "maturity": {"$ref": "#/$defs/maturity"}
      },
      "unevaluatedProperties": false
    },
    "interface": {
      "allOf": [
        {
          "$ref": "#/$defs/base_entity"
        }
      ],
      "properties": {
        "id": true,
        "name": true,
        "description": true,
        "status": true,
        "tags": true,
        "source_file": true,
        "source_line": true,
        "type": {
          "type": "string",
          "enum": [
            "REST",
            "WebSocket",
            "database",
            "file",
            "message-queue",
            "internal",
            "external"
          ]
        },
        "protocol": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "consumer": {
          "type": "string"
        },
        "data_format": {
          "type": "string"
        },
        "endpoints": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "request_schema": {
                "type": "string"
              },
              "response_schema": {
                "type": "string"
              }
            }
          }
        },
        "schema": {
          "type": "string"
        },
        "subkind": {
          "type": "string",
          "description": "Interface flavor: api, cli_command, http_route, plugin_hook, event, data, message. Not strictly enum-enforced so extractors may add framework-specific subkinds."
        },
        "metadata": {
          "type": "object",
          "description": "Freeform extractor metadata (args, http_method, path, entry_point_group, framework, target)."
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        },
        "contract": {
          "type": "string"
        },
        "intent": true,
        "decisions": true,
        "stakeholders": {"$ref": "#/$defs/semantic_string_list"},
        "success_criteria": {"$ref": "#/$defs/semantic_string_list"},
        "assumptions": {"$ref": "#/$defs/semantic_string_list"},
        "open_questions": {"$ref": "#/$defs/semantic_string_list"},
        "verification": {"$ref": "#/$defs/verification_ref_list"},
        "slos": {"$ref": "#/$defs/slo_list"},
        "maturity": {"$ref": "#/$defs/maturity"}
      },
      "unevaluatedProperties": false
    },
    "constraint": {
      "allOf": [
        {
          "$ref": "#/$defs/base_entity"
        }
      ],
      "properties": {
        "id": true,
        "name": true,
        "description": true,
        "status": true,
        "tags": true,
        "source_file": true,
        "source_line": true,
        "type": {
          "type": "string",
          "enum": [
            "performance",
            "security",
            "reliability",
            "scalability",
            "regulatory",
            "technology",
            "operational",
            "failure-mode"
          ]
        },
        "metric": {
          "type": "string"
        },
        "threshold": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        },
        "intent": true,
        "decisions": true,
        "success_criteria": {"$ref": "#/$defs/semantic_string_list"},
        "assumptions": {"$ref": "#/$defs/semantic_string_list"},
        "open_questions": {"$ref": "#/$defs/semantic_string_list"},
        "verification": {"$ref": "#/$defs/verification_ref_list"},
        "maturity": {"$ref": "#/$defs/maturity"}
      },
      "unevaluatedProperties": false
    },
    "layer": {
      "allOf": [
        {
          "$ref": "#/$defs/base_entity"
        }
      ],
      "properties": {
        "id": true,
        "name": true,
        "description": true,
        "status": true,
        "tags": true,
        "source_file": true,
        "source_line": true,
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "technology": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "directories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        },
        "intent": true,
        "decisions": true,
        "owner": {"type": "string"},
        "maturity": {"$ref": "#/$defs/maturity"}
      },
      "unevaluatedProperties": false
    },
    "component": {
      "allOf": [
        {
          "$ref": "#/$defs/base_entity"
        }
      ],
      "properties": {
        "id": true,
        "name": true,
        "description": true,
        "status": true,
        "tags": true,
        "source_file": true,
        "source_line": true,
        "layer": {
          "type": "string"
        },
        "source_block": {
          "type": "string"
        },
        "technology": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "responsibilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kind": {
          "type": "string",
          "enum": [
            "module",
            "package",
            "service",
            "library",
            "cli",
            "data-model",
            "data-store",
            "infrastructure",
            "framework",
            "ui",
            "pipeline"
          ]
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "required": {
                "type": "boolean"
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "region": {
          "type": "string"
        },
        "contract": {
          "type": "string"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "symbols": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "class",
                  "dataclass",
                  "exception",
                  "protocol",
                  "struct",
                  "interface",
                  "enum",
                  "trait",
                  "type-alias"
                ]
              },
              "members": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "supers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "functions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "constants": {
          "type": "array",
          "items": {
            "type": "object",
