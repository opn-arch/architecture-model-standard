      "file": "src/architecture_model/orchestration/decompose.py",
      "name": "Generate recursive sub",
      "docstring": "Generate recursive sub-models from parent model via relationship tracing.\n\nFor each F-block, produces an ArchitectureModel by tracing relationships\noutward from the block's components:\n- realizes --> Capability\n- exposes --> Interface\n- traces-to --> Behavior\n- constrained-by --> Constraint\n- depends-on --> boundary relationships to external components\n\nThis produces sub-models that are faithful slices of the parent model,\nnot invented entities.",
      "functions": [
        {
          "name": "decompose_model",
          "signature": "decompose_model(project_root, model_path)",
          "calls": [
            "monitored",
            "load_model",
